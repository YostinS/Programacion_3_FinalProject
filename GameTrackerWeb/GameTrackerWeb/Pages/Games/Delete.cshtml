@page "{id:int}"
@model GameTrackerWeb.Pages.Games.DeleteModel

<h2>Delete Game</h2>

<p>
    Are you sure you want to delete
    <strong>@Model.Game.Name</strong>?
</p>

<form method="post">

    <input type="hidden"
           asp-for="Game.Id" />

    <button type="submit">
        Delete
    </button>

</form>