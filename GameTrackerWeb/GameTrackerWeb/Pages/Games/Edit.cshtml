@page "{id:int}"
@model GameTrackerWeb.Pages.Games.EditModel

<h2>Edit Game</h2>

<form method="post">

    <input type="hidden" asp-for="Game.Id" />

    <div>
        <label>Name</label>
        <input asp-for="Game.Name" />
    </div>

    <br />

    <div>
        <label>Status</label>

        <select asp-for="Game.Status">

            <option>Pending</option>
            <option>Played</option>

        </select>
    </div>

    <br />

    <button type="submit">
        Update
    </button>

</form>