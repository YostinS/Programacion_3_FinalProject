@page
@model GameTrackerWeb.Pages.Games.CreateModel

<h2>Add Game</h2>

<form method="post">

    <div>
        <label>Name</label>
        <input asp-for="Game.Name" />
    </div>

    <br />

    <div>
        <label>Status</label>

        <select asp-for="Game.Status">

            <option>Pending</option>
            <option>Played</option>

        </select>
    </div>

    <br />

    <button type="submit">
        Save
    </button>

</form>