@page
@model GameTrackerWeb.Pages.Login.IndexModel

<h2>Login</h2>

<form method="post">

    <div>
        <label>User</label>
        <input asp-for="Username" />
    </div>

    <br />

    <div>
        <label>Password</label>
        <input asp-for="Password" type="password" />
    </div>

    <br />

    <button type="submit">
        Login
    </button>

</form>

<p style="color:red">
    @Model.ErrorMessage
</p>